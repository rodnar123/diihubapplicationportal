# ---------------------------------------------------------------------------
# PNGUoT Student Challenge Application Portal — environment template
# Copy to `.env` (local dev) and set real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# DATABASE_URL  : pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL    : direct connection (port 5432) used by `prisma migrate`.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Authentication (NextAuth + Google OAuth) ------------------------------
# Generate with:  npx auth secret
AUTH_SECRET="<random-32+-character-secret>"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Authorised redirect URI must be:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="<client-id>.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="<client-secret>"

# --- Supabase (Storage only — it no longer issues sessions) ----------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Server-only. Grants full access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="application-attachments"

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PNGUoT Student Challenge Portal"

# Only these domains may hold an account.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN="student.pnguot.ac.pg"
STAFF_EMAIL_DOMAIN="pnguot.ac.pg"

# Comma-separated staff addresses bootstrapped as ADMIN on first sign-in.
ADMIN_EMAIL_ALLOWLIST="challenge.admin@pnguot.ac.pg"

# --- Email (Resend) --------------------------------------------------------
# Leave RESEND_API_KEY empty in development: mail is logged to the console
# instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="PNGUoT Student Challenge <no-reply@pnguot.ac.pg>"
# Where "new submission" alerts are delivered.
ADMIN_NOTIFICATION_EMAILS="challenge.admin@pnguot.ac.pg"
