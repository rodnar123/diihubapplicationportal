// PNGUoT Student Challenge Application Portal
// ---------------------------------------------------------------------------
// Normalised schema for the DiiHub BizTech Challenge application workflow.
//
// Conventions used throughout:
//   * `deletedAt` marks a soft delete. Every read path filters on it; nothing
//     is ever hard-deleted so that audit trails stay intact.
//   * Long-form narrative answers are stored as sanitised HTML (rich text).
//   * Reference data (School, Section) lives in tables rather than enums so
//     that faculty can extend it without a migration, and so dashboard
//     aggregations can group by a real foreign key.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 resolves connection URLs from `prisma.config.ts` (CLI/migrations)
// and from the driver adapter passed to `new PrismaClient()` (runtime).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Fixed role set for role-based access control.
enum Role {
  STUDENT
  REVIEWER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum YearLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  POSTGRADUATE
}

/// Which declaration method a team used. The methods an admin permits are
/// controlled separately via the `declaration.mode` application setting.
enum DeclarationMode {
  ELECTRONIC
  SIGNED_UPLOAD
}

enum AttachmentKind {
  SUPPORTING_DOCUMENT
  PROTOTYPE_ASSET
  SIGNED_DECLARATION
}

enum CommentVisibility {
  /// Visible to the applicant — used for revision feedback.
  SHARED
  /// Internal reviewer notes. Never leaves the admin console.
  INTERNAL
}

/// Where one reviewer has got to with one application.
///
/// The distinction that matters is SUBMITTED: until a reviewer commits, their
/// marks are a working draft and are deliberately excluded from the aggregate,
/// so a half-scored entry cannot drag a ranking around while the panel works.
enum ReviewAssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  /// The reviewer stepped away — they supervise the team, taught the members,
  /// or otherwise should not be marking this entry.
  RECUSED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_RESUBMITTED
  REVISION_REQUESTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_UNDER_REVIEW
  COMMENT_ADDED
  NEW_SUBMISSION_FOR_REVIEW
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  /// Always stored lower-cased. Domain is enforced in the application layer
  /// and by a database CHECK constraint added in the initial migration.
  email String @unique
  name  String
  role  Role   @default(STUDENT)

  /// The identity provider's stable subject id (Google's `sub` claim).
  /// Authentication is Google's job; this column only records which external
  /// identity this row belongs to. Roles are never read from the provider.
  authProviderId String? @unique

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  studentProfile     StudentProfile?
  applications       Application[]    @relation("ApplicationOwner")
  reviewedApps       Application[]    @relation("ApplicationReviewer")
  comments           Comment[]
  statusChanges      StatusHistory[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  uploadedAttachments Attachment[]
  settingUpdates     AppSetting[]
  reviewAssignments  ReviewAssignment[] @relation("ReviewAssignmentReviewer")
  assignmentsMade    ReviewAssignment[] @relation("ReviewAssignmentAssigner")
  teamMemberships    TeamMember[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// PNGUoT student number, e.g. "25530061".
  studentId String  @unique
  firstName String
  surname   String
  phone     String?

  schoolId  String?
  sectionId String?
  program   String?
  yearLevel YearLevel?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school  School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([sectionId])
  @@index([surname, firstName])
  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model School {
  id        String  @id @default(cuid())
  name      String  @unique
  code      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections     Section[]
  profiles     StudentProfile[]
  applications Application[]

  @@index([isActive, sortOrder])
  @@map("schools")
}

model Section {
  id       String  @id @default(cuid())
  schoolId String
  /// e.g. "Information Technology", "Accounting", "Applied Economics".
  name     String
  code     String
  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profiles     StudentProfile[]
  applications Application[]
  teamMembers  TeamMember[]

  @@unique([schoolId, code])
  @@index([isActive, sortOrder])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// Application
// ---------------------------------------------------------------------------

model Application {
  id String @id @default(cuid())

  /// Human-facing identifier, e.g. "DBTC-2026-0007". Assigned on first submit.
  referenceNumber String? @unique

  ownerId       String
  status        ApplicationStatus @default(DRAFT)
  challengeYear Int

  // --- Section A: applicant details (snapshot at time of application) ------
  applicantPhone String?
  schoolId       String?
  sectionId      String?
  program        String?
  yearLevel      YearLevel?

  // --- Section C: venture / project ---------------------------------------
  projectTitle      String?
  theme             String?
  /// SDG codes, e.g. ["SDG_4", "SDG_9"].
  sdgAlignment      String[] @default([])
  problemStatement  String?
  proposedSolution  String?
  innovation        String?
  objectives        String?
  targetUsers       String?
  expectedImpact    String?
  sustainability    String?
  budgetAmount      Decimal? @db.Decimal(12, 2)
  budgetNotes       String?
  timeline          String?

  // --- Prototype details ---------------------------------------------------
  prototypeType     String?
  prototypeFeatures String?
  developmentTools  String?

  // --- Alternative solutions vs this solution ------------------------------
  alternatives  String?
  justification String?

  // --- Impact & feasibility ------------------------------------------------
  valueProposition   String?
  implementationPlan String?

  // --- Workflow ------------------------------------------------------------
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  decisionNote  String?
  /// Incremented every time the team re-submits after a revision request.
  revisionCount Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner      User     @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  team          Team?
  declaration   Declaration?
  attachments   Attachment[]
  statusHistory StatusHistory[]
  comments      Comment[]
  notifications Notification[]
  assignments   ReviewAssignment[]

  /// A student may hold at most one application per challenge year. Enforced
  /// as a partial unique index in the migration so that soft-deleted rows do
  /// not block a fresh start.
  @@index([ownerId, challengeYear])
  @@index([status, challengeYear])
  @@index([submittedAt])
  @@index([schoolId])
  @@index([sectionId])
  @@index([deletedAt])
  @@map("applications")
}

model Team {
  id            String @id @default(cuid())
  applicationId String @unique

  name String

  leaderName      String
  leaderStudentId String
  leaderEmail     String
  leaderPhone     String?

  supervisorName  String?
  supervisorEmail String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  members     TeamMember[]

  @@index([name])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String

  /// The account this roster line belongs to, once the member has signed in
  /// and claimed it.
  ///
  /// Nullable because the leader types the roster from memory before anyone
  /// else has logged in — `studentId` is what they know, and it is the only
  /// thing available at that moment. The link is made later, when the named
  /// student signs in and their profile's student number matches this row.
  ///
  /// Until then `studentId` is free text, which is why the "one student, one
  /// team" rule can only compare typed strings. Once linked, the rule has a
  /// real identity to enforce against.
  userId String?

  studentId String
  firstName String
  surname   String
  sectionId String?
  /// Free-text fallback when the section is not in the reference list.
  sectionLabel String?
  /// Role within the team, e.g. "Developer", "Business Analyst".
  role      String?
  email     String?
  phone     String?
  isLeader  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([teamId, studentId])
  @@index([studentId])
  @@index([sectionId])
  @@index([userId])
  @@map("team_members")
}

model Declaration {
  id            String @id @default(cuid())
  applicationId String @unique

  mode     DeclarationMode
  accepted Boolean         @default(false)

  /// Typed full name for the electronic declaration.
  signatoryName String?
  signedAt      DateTime?

  /// Captured for non-repudiation of the electronic declaration.
  ipAddress String?
  userAgent String?

  /// Set when `mode` is SIGNED_UPLOAD.
  signedDocumentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  signedDocument Attachment? @relation("SignedDeclaration", fields: [signedDocumentId], references: [id], onDelete: SetNull)

  @@map("declarations")
}

model Attachment {
  id            String @id @default(cuid())
  applicationId String

  kind        AttachmentKind @default(SUPPORTING_DOCUMENT)
  fileName    String
  /// Object key inside the Supabase Storage bucket. Never a public URL —
  /// downloads always go through a short-lived signed URL.
  storagePath String         @unique
  mimeType    String
  sizeBytes   Int
  checksum    String?

  uploadedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  declaration Declaration? @relation("SignedDeclaration")

  @@index([applicationId, kind])
  @@index([deletedAt])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Review panel: rubric, assignment and scoring
//
// The status machine answers "what happened to this entry". None of it answers
// "which of these sixty entries is best", which is the question a competition
// actually has to settle. These three tables are that second answer, and they
// sit *beside* the decision rather than gating it: a panel can still approve an
// entry outright, and an aggregate score never changes a status on its own.
// ---------------------------------------------------------------------------

/// One line of the marking rubric.
///
/// Reference data rather than an enum, for the same reason School and Section
/// are tables: the challenge office reweights the rubric between cycles and
/// must not need a migration to do it.
model ReviewCriterion {
  id String @id @default(cuid())

  /// Stable machine name, e.g. "INNOVATION". Unique within a challenge year.
  code        String
  name        String
  description String?

  /// Relative weight in the aggregate. Integers so that a rubric summing to
  /// 100 can be read straight off as percentages.
  weight Int @default(1)

  /// Highest mark a reviewer may award on this line. 5 and 10 are both common
  /// and the domain does not care which, so it is per-criterion.
  maxValue Int @default(5)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Rubrics are versioned by cycle. Editing next year's criteria must not
  /// retroactively rescore a cohort that has already been decided, so a new
  /// year gets new rows rather than edits to the old ones.
  challengeYear Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  @@unique([challengeYear, code])
  @@index([challengeYear, isActive, sortOrder])
  @@map("review_criteria")
}

/// One reviewer's allocation of one application.
///
/// Distinct from `Application.reviewedById`, which records who *decided* and is
/// written after the fact. This is the work list: who is expected to look at
/// what, and how far they have got.
model ReviewAssignment {
  id String @id @default(cuid())

  applicationId String
  reviewerId    String

  status ReviewAssignmentStatus @default(PENDING)

  /// Set when the reviewer commits. Until then their marks are a draft and are
  /// excluded from every aggregate.
  submittedAt DateTime?

  /// Required when `status` is RECUSED, so a conflict of interest leaves a
  /// record rather than a silently missing score.
  recusedReason String?

  /// Who allocated the work. Null for a self-claimed entry.
  assignedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("ReviewAssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  assignedBy  User?       @relation("ReviewAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  scores      Score[]

  /// One allocation per reviewer per application. Enforced as a partial unique
  /// index in the migration so a withdrawn allocation can be re-made.
  @@index([applicationId, reviewerId])
  @@index([reviewerId, status])
  @@index([deletedAt])
  @@map("review_assignments")
}

/// One reviewer's mark against one criterion.
model Score {
  id String @id @default(cuid())

  assignmentId String
  criterionId  String

  /// Bounded by the criterion's `maxValue`, checked in the domain and by a
  /// CHECK constraint that a raw query cannot get around.
  value Int

  /// Optional justification. Reviewers are asked for one on the low and high
  /// ends, where a bare number is least defensible if a student appeals.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterion  ReviewCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, criterionId])
  @@index([criterionId])
  @@map("scores")
}

model StatusHistory {
  id            String @id @default(cuid())
  applicationId String

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  actorId    String?
  /// Reason or feedback recorded with the transition.
  note       String?

  createdAt DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("status_history")
}

model Comment {
  id            String @id @default(cuid())
  applicationId String
  authorId      String

  body       String
  visibility CommentVisibility @default(INTERNAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([deletedAt])
  @@map("comments")
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type          NotificationType
  title         String
  body          String
  applicationId String?

  readAt      DateTime?
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  /// Denormalised so the trail survives account deletion.
  actorEmail String?

  /// Dot-namespaced verb, e.g. "application.submitted".
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Runtime configuration an administrator can change without a deployment:
/// maximum team size, upload limits, active declaration mode, submission
/// window, and the selectable theme list.
model AppSetting {
  key         String  @id
  value       Json
  description String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
